rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }
    
    function isMentor() {
      return isSignedIn() && (getUserData().role == 'mentor' || getUserData().role == 'admin');
    }

    // Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin();
    }

    // Projects collection
    match /projects/{projectId} {
      allow read: if isSignedIn() && (request.auth.uid == resource.data.userId || isMentor());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == resource.data.userId || isMentor());
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      
      // Steps subcollection
      match /steps/{stepId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }
  }
}
